---
import HeroContent from '../HeroContent.astro';
import HeroShared from './HeroShared.astro';

type NodeRole = 'hub' | 'cap' | 'stem' | 'leaf';

interface NetworkNode {
  id: number;
  x: number;
  y: number;
  r: number;
  cluster: string;
  role: NodeRole;
}

interface ClusterDef {
  id: string;
  cx: number;
  cy: number;
  capRx: number;
  capRy: number;
  hub: { id: number; r: number };
  members: Array<{ id: number; angle: number; dist: number; r: number; role: NodeRole }>;
}

const clusters: ClusterDef[] = [
  {
    id: 'alpha',
    cx: 668,
    cy: 82,
    capRx: 138,
    capRy: 76,
    hub: { id: 2, r: 13 },
    members: [
      { id: 1, angle: -42, dist: 78, r: 6, role: 'cap' },
      { id: 10, angle: 8, dist: 88, r: 7, role: 'cap' },
      { id: 11, angle: 44, dist: 72, r: 6, role: 'cap' },
      { id: 6, angle: 122, dist: 118, r: 6, role: 'stem' },
    ],
  },
  {
    id: 'beta',
    cx: 498,
    cy: 268,
    capRx: 132,
    capRy: 72,
    hub: { id: 8, r: 12 },
    members: [
      { id: 13, angle: -58, dist: 76, r: 5, role: 'cap' },
      { id: 3, angle: -12, dist: 84, r: 6, role: 'cap' },
      { id: 5, angle: 28, dist: 80, r: 6, role: 'cap' },
      { id: 14, angle: 92, dist: 104, r: 5, role: 'stem' },
      { id: 9, angle: 132, dist: 132, r: 6, role: 'leaf' },
    ],
  },
  {
    id: 'gamma',
    cx: 648,
    cy: 472,
    capRx: 142,
    capRy: 78,
    hub: { id: 7, r: 13 },
    members: [
      { id: 4, angle: -62, dist: 84, r: 7, role: 'cap' },
      { id: 12, angle: 4, dist: 78, r: 6, role: 'cap' },
      { id: 15, angle: 38, dist: 74, r: 6, role: 'cap' },
      { id: 16, angle: 112, dist: 120, r: 5, role: 'stem' },
    ],
  },
];

function polar(cx: number, cy: number, angleDeg: number, dist: number) {
  const radians = (angleDeg * Math.PI) / 180;
  return {
    x: cx + Math.cos(radians) * dist,
    y: cy + Math.sin(radians) * dist,
  };
}

const nodeMap = new Map<number, NetworkNode>();

for (const cluster of clusters) {
  nodeMap.set(cluster.hub.id, {
    id: cluster.hub.id,
    x: cluster.cx,
    y: cluster.cy,
    r: cluster.hub.r,
    cluster: cluster.id,
    role: 'hub',
  });

  for (const member of cluster.members) {
    const point = polar(cluster.cx, cluster.cy, member.angle, member.dist);
    nodeMap.set(member.id, {
      id: member.id,
      x: point.x,
      y: point.y,
      r: member.r,
      cluster: cluster.id,
      role: member.role,
    });
  }
}

const nodes = [...nodeMap.values()].sort((a, b) => a.id - b.id);

const intraEdges = clusters.flatMap((cluster) => {
  const hubId = cluster.hub.id;
  const spokes = cluster.members.map((member) => [hubId, member.id] as [number, number]);
  const stemChains = cluster.members
    .filter((member) => member.role === 'leaf')
    .map((member) => {
      const stem = cluster.members.find((entry) => entry.role === 'stem');
      return stem ? ([stem.id, member.id] as [number, number]) : null;
    })
    .filter((edge): edge is [number, number] => edge !== null);

  return [...spokes, ...stemChains];
});

const bridgeEdges: Array<[number, number]> = [
  [6, 4],
  [9, 16],
  [11, 4],
];

const edges = [...intraEdges, ...bridgeEdges].map(([from, to]) => ({
  from,
  to,
  bridge: bridgeEdges.some(([a, b]) => (a === from && b === to) || (a === to && b === from)),
}));

const nodeById = Object.fromEntries(nodes.map((node) => [node.id, node]));
---

<HeroShared />
<section class="hero-variant hero-network" data-hero-network>
  <div class="hero-bg" aria-hidden="true">
    <svg class="network-graph" viewBox="300 0 560 560" preserveAspectRatio="xMaxYMid meet" overflow="visible">
      <defs>
        <linearGradient id="edge-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop class="edge-gradient-stop" offset="0%" stop-color="rgba(91, 141, 239, 0.03)" />
          <stop class="edge-gradient-stop edge-gradient-stop--mid" offset="50%" stop-color="rgba(91, 141, 239, 0.14)" />
          <stop class="edge-gradient-stop" offset="100%" stop-color="rgba(91, 141, 239, 0.03)" />
        </linearGradient>
        <linearGradient id="edge-bridge-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="rgba(91, 141, 239, 0.035)" />
          <stop offset="50%" stop-color="rgba(130, 172, 255, 0.1)" />
          <stop offset="100%" stop-color="rgba(91, 141, 239, 0.035)" />
        </linearGradient>
        <radialGradient id="node-gradient-hub">
          <stop class="node-gradient-stop" offset="0%" stop-color="rgba(196, 218, 255, 0.38)" />
          <stop offset="100%" stop-color="rgba(62, 106, 225, 0.18)" />
        </radialGradient>
        <radialGradient id="node-gradient-cap">
          <stop class="node-gradient-stop" offset="0%" stop-color="rgba(160, 196, 255, 0.28)" />
          <stop offset="100%" stop-color="rgba(62, 106, 225, 0.14)" />
        </radialGradient>
        <radialGradient id="node-gradient-stem">
          <stop class="node-gradient-stop" offset="0%" stop-color="rgba(130, 168, 240, 0.22)" />
          <stop offset="100%" stop-color="rgba(62, 106, 225, 0.1)" />
        </radialGradient>
        <radialGradient id="cluster-cap-gradient">
          <stop offset="0%" stop-color="rgba(100, 150, 255, 0.09)" />
          <stop offset="55%" stop-color="rgba(70, 120, 230, 0.045)" />
          <stop offset="100%" stop-color="rgba(62, 106, 225, 0)" />
        </radialGradient>
        <filter id="node-glow" x="-120%" y="-120%" width="340%" height="340%">
          <feGaussianBlur stdDeviation="2.4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="cluster-cap-blur" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
      </defs>

      <g class="cluster-caps">
        {
          clusters.map((cluster) => (
            <ellipse
              class="cluster-cap"
              data-cluster={cluster.id}
              cx={cluster.cx}
              cy={cluster.cy - 8}
              rx={cluster.capRx}
              ry={cluster.capRy}
              fill="url(#cluster-cap-gradient)"
              filter="url(#cluster-cap-blur)"
            />
          ))
        }
      </g>

      <g class="edges">
        {
          edges.map(({ from, to, bridge }) => {
            const a = nodeById[from];
            const b = nodeById[to];
            return (
              <line
                class:list={{ 'edge-bridge': bridge }}
                data-edge-from={from}
                data-edge-to={to}
                data-edge-bridge={bridge ? 'true' : 'false'}
                x1={a.x}
                y1={a.y}
                x2={b.x}
                y2={b.y}
                stroke={bridge ? 'url(#edge-bridge-gradient)' : 'url(#edge-gradient)'}
                stroke-width={bridge ? 1.05 : 1.35}
              />
            );
          })
        }
      </g>

      <g class="nodes" filter="url(#node-glow)">
        {
          nodes.map((node) => {
            const fill =
              node.role === 'hub'
                ? 'url(#node-gradient-hub)'
                : node.role === 'stem' || node.role === 'leaf'
                  ? 'url(#node-gradient-stem)'
                  : 'url(#node-gradient-cap)';

            return (
              <g
                class:list={{
                  'network-node': true,
                  'network-node--hub': node.role === 'hub',
                  'network-node--stem': node.role === 'stem' || node.role === 'leaf',
                }}
                data-node-id={node.id}
                data-cluster={node.cluster}
                data-node-role={node.role}
              >
                <circle
                  class="network-node-halo"
                  cx={node.x}
                  cy={node.y}
                  r={node.r + (node.role === 'hub' ? 8 : 4)}
                  fill={node.role === 'hub' ? 'rgba(91, 141, 239, 0.04)' : 'none'}
                  stroke="rgba(91, 141, 239, 0.07)"
                  stroke-width="1"
                />
                <circle
                  class="network-node-core"
                  cx={node.x}
                  cy={node.y}
                  r={node.r}
                  fill={fill}
                />
              </g>
            );
          })
        }
      </g>
    </svg>
  </div>
  <HeroContent />
  <a href="#products" class="hero-scroll-cue">
    <span class="hero-scroll-label">Explore Vorteks</span>
    <span class="hero-scroll-icon" aria-hidden="true"></span>
  </a>
</section>

<script define:vars={{ nodes, edges, clusters }}>
  const hero = document.querySelector('[data-hero-network]');

  if (hero) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const edgeElements = hero.querySelectorAll('.edges line');
    const nodeElements = hero.querySelectorAll('.network-node');
    const motionStart = performance.now();
    let scrollTicking = false;
    let physicsFrame = 0;

    const clusterMetaById = Object.fromEntries(clusters.map((cluster) => [cluster.id, cluster]));
    const nodeMetaById = Object.fromEntries(nodes.map((node) => [node.id, node]));

    const nodeState = [...nodeElements].map((element, index) => {
      const halo = element.querySelector('.network-node-halo');
      const core = element.querySelector('.network-node-core');
      const meta = nodeMetaById[Number(element.getAttribute('data-node-id'))];
      const baseX = meta?.x ?? Number(core?.getAttribute('cx') ?? 0);
      const baseY = meta?.y ?? Number(core?.getAttribute('cy') ?? 0);

      return {
        id: Number(element.getAttribute('data-node-id')),
        cluster: element.getAttribute('data-cluster'),
        role: element.getAttribute('data-node-role'),
        halo,
        core,
        baseX,
        baseY,
        x: baseX,
        y: baseY,
        vx: 0,
        vy: 0,
        driftPhase: index * 1.65 + (meta?.id ?? index) * 0.41,
      };
    });

    const nodeStateById = Object.fromEntries(nodeState.map((node) => [node.id, node]));
    const nodeIndexById = Object.fromEntries(nodeState.map((node, index) => [node.id, index]));
    const edgePairs = edges.map(({ from, to, bridge }) => ({
      from,
      to,
      bridge,
      sourceIndex: nodeIndexById[from],
      targetIndex: nodeIndexById[to],
      idealLength: bridge ? 148 : 68,
    }));

    const updateScrollProgress = () => {
      const progress = Math.min(Math.max(window.scrollY / hero.offsetHeight, 0), 1);
      hero.style.setProperty('--scroll-progress', progress.toFixed(4));
      scrollTicking = false;
    };

    const onScroll = () => {
      if (!scrollTicking) {
        scrollTicking = true;
        requestAnimationFrame(updateScrollProgress);
      }
    };

    const setNodePosition = (node) => {
      node.halo?.setAttribute('cx', String(node.x));
      node.halo?.setAttribute('cy', String(node.y));
      node.core?.setAttribute('cx', String(node.x));
      node.core?.setAttribute('cy', String(node.y));
    };

    const updateClusterCaps = () => {
      clusters.forEach((cluster) => {
        const cap = hero.querySelector(`.cluster-cap[data-cluster="${cluster.id}"]`);
        const clusterNodes = nodeState.filter((node) => node.cluster === cluster.id);

        if (!cap || clusterNodes.length === 0) return;

        const hub = clusterNodes.find((node) => node.role === 'hub');
        const capNodes = clusterNodes.filter((node) => node.role === 'cap');

        if (!hub) return;

        let sumX = hub.x;
        let sumY = hub.y;
        let count = 1;

        capNodes.forEach((node) => {
          sumX += node.x;
          sumY += node.y;
          count += 1;
        });

        const centerX = sumX / count;
        const centerY = sumY / count - 10;
        let spreadX = cluster.capRx * 0.55;
        let spreadY = cluster.capRy * 0.55;

        capNodes.forEach((node) => {
          spreadX = Math.max(spreadX, Math.abs(node.x - centerX) + nodeMetaById[node.id].r + 14);
          spreadY = Math.max(spreadY, Math.abs(node.y - centerY) * 0.72 + nodeMetaById[node.id].r + 10);
        });

        cap.setAttribute('cx', String(centerX));
        cap.setAttribute('cy', String(centerY));
        cap.setAttribute('rx', String(spreadX));
        cap.setAttribute('ry', String(spreadY));
      });
    };

    const updateEdges = () => {
      edgeElements.forEach((edge) => {
        const from = nodeStateById[Number(edge.getAttribute('data-edge-from'))];
        const to = nodeStateById[Number(edge.getAttribute('data-edge-to'))];

        if (!from || !to) return;

        edge.setAttribute('x1', String(from.x));
        edge.setAttribute('y1', String(from.y));
        edge.setAttribute('x2', String(to.x));
        edge.setAttribute('y2', String(to.y));
      });
    };

    const simulateNetwork = (now) => {
      const motionScale = reducedMotion ? 0.4 : 1;
      const ambientTime = (now - motionStart) * 0.00038 * motionScale;
      const repulsionStrength = 820;
      const attractionStrength = 0.0034;
      const wanderStrength = 0.018;
      const centerGravity = 0.00012;
      const damping = 0.86;
      const layoutCenter = { x: 548, y: 278 };

      const forces = nodeState.map(() => ({ x: 0, y: 0 }));

      for (let i = 0; i < nodeState.length; i += 1) {
        for (let j = i + 1; j < nodeState.length; j += 1) {
          const a = nodeState[i];
          const b = nodeState[j];
          const sameCluster = a.cluster === b.cluster;
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distanceSq = dx * dx + dy * dy + (sameCluster ? 640 : 1200);
          const distance = Math.sqrt(distanceSq);
          const clusterBoost = sameCluster ? 1.15 : 0.85;
          const repulsion = (repulsionStrength * clusterBoost) / distanceSq;
          const repulsionX = (dx / distance) * repulsion;
          const repulsionY = (dy / distance) * repulsion;

          forces[i].x += repulsionX;
          forces[i].y += repulsionY;
          forces[j].x -= repulsionX;
          forces[j].y -= repulsionY;
        }
      }

      for (const { sourceIndex, targetIndex, idealLength, bridge } of edgePairs) {
        if (sourceIndex === undefined || targetIndex === undefined) continue;

        const source = nodeState[sourceIndex];
        const target = nodeState[targetIndex];
        const dx = target.x - source.x;
        const dy = target.y - source.y;
        const distance = Math.hypot(dx, dy) + 0.001;
        const displacement = distance - idealLength;
        const stiffness = bridge ? attractionStrength * 0.68 : attractionStrength;
        const force = displacement * stiffness;
        const forceX = (dx / distance) * force;
        const forceY = (dy / distance) * force;

        forces[sourceIndex].x += forceX;
        forces[sourceIndex].y += forceY;
        forces[targetIndex].x -= forceX;
        forces[targetIndex].y -= forceY;
      }

      clusters.forEach((cluster) => {
        const meta = clusterMetaById[cluster.id];
        const clusterNodes = nodeState.filter((node) => node.cluster === cluster.id);
        const hub = clusterNodes.find((node) => node.role === 'hub');

        if (!hub || !meta) return;

        let centroidX = 0;
        let centroidY = 0;

        clusterNodes.forEach((node) => {
          centroidX += node.x;
          centroidY += node.y;
        });

        centroidX /= clusterNodes.length;
        centroidY /= clusterNodes.length;

        const dx = meta.cx - centroidX;
        const dy = meta.cy - centroidY;

        clusterNodes.forEach((node) => {
          const index = nodeIndexById[node.id];
          forces[index].x += dx * 0.0016;
          forces[index].y += dy * 0.0016;
        });

      });

      nodeState.forEach((node, index) => {
        let forceX = forces[index].x;
        let forceY = forces[index].y;

        const wanderRadius =
          (node.role === 'hub' ? 7 : node.role === 'cap' ? 11 : node.role === 'stem' ? 8 : 9) *
          motionScale;
        const targetX =
          node.baseX + Math.sin(ambientTime + node.driftPhase) * wanderRadius;
        const targetY =
          node.baseY +
          Math.cos(ambientTime * 0.84 + node.driftPhase) * wanderRadius * 0.9;

        forceX += (targetX - node.x) * wanderStrength;
        forceY += (targetY - node.y) * wanderStrength;
        forceX += (layoutCenter.x - node.x) * centerGravity;
        forceY += (layoutCenter.y - node.y) * centerGravity;

        node.vx = (node.vx + forceX) * damping;
        node.vy = (node.vy + forceY) * damping;
        node.x += node.vx;
        node.y += node.vy;

        setNodePosition(node);
      });

      updateClusterCaps();
      updateEdges();
      physicsFrame = requestAnimationFrame(simulateNetwork);
    };

    updateScrollProgress();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateScrollProgress);

    nodeState.forEach(setNodePosition);
    updateClusterCaps();
    updateEdges();

    if (reducedMotion) {
      hero.classList.add('is-reduced-motion');
    }

    physicsFrame = requestAnimationFrame(simulateNetwork);

    window.addEventListener('beforeunload', () => {
      cancelAnimationFrame(physicsFrame);
    });
  }
</script>

<style>
  .hero-network {
    --scroll-progress: 0;
    --network-opacity: 0.48;
    overflow: hidden;
  }

  .hero-network .hero-scroll-cue {
    opacity: calc(1 - var(--scroll-progress) * 2.5);
    transform: translateX(-50%) translateY(calc(var(--scroll-progress) * -12px));
    transition: opacity 0.15s ease;
  }

  .hero-network .hero-content {
    transform: translateY(calc(var(--scroll-progress) * -28px));
    opacity: calc(1 - var(--scroll-progress) * 0.35);
  }

  .hero-network.is-reduced-motion .hero-content,
  .hero-network.is-reduced-motion .network-graph {
    transform: none;
    filter: none;
  }

  .hero-network.is-reduced-motion .hero-content {
    opacity: calc(1 - var(--scroll-progress) * 0.4);
  }

  .hero-network.is-reduced-motion .network-graph {
    opacity: calc(var(--network-opacity) * (1 - var(--scroll-progress) * 0.5));
  }

  .hero-network .hero-bg {
    background:
      radial-gradient(ellipse 90% 80% at 10% 40%, rgba(62, 106, 225, 0.09), transparent 55%),
      radial-gradient(ellipse 85% 75% at 88% 52%, rgba(91, 141, 239, 0.1), transparent 58%),
      linear-gradient(160deg, #0b0d12 0%, #101620 45%, #0d1119 100%);
  }

  .network-graph {
    position: absolute;
    top: 50%;
    right: 0;
    left: 6%;
    width: auto;
    height: 228%;
    min-width: 0;
    overflow: visible;
    transform:
      translateY(calc(-50% - var(--scroll-progress) * 140px))
      translateX(calc(var(--scroll-progress) * 48px))
      scale(calc(1 + var(--scroll-progress) * 0.2))
      rotate(calc(var(--scroll-progress) * 5deg));
    opacity: calc(var(--network-opacity) * (1 - var(--scroll-progress) * 0.8));
    filter: blur(calc(var(--scroll-progress) * 4px));
    will-change: transform, opacity, filter;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent calc(16% + var(--scroll-progress) * 6%),
      rgba(0, 0, 0, 0.45) calc(28% + var(--scroll-progress) * 5%),
      rgba(0, 0, 0, 0.88) calc(42% + var(--scroll-progress) * 4%),
      black calc(54% + var(--scroll-progress) * 4%),
      black calc(76% - var(--scroll-progress) * 4%),
      rgba(0, 0, 0, 0.65) calc(88% - var(--scroll-progress) * 3%),
      transparent calc(96% - var(--scroll-progress) * 2%)
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent calc(16% + var(--scroll-progress) * 6%),
      rgba(0, 0, 0, 0.45) calc(28% + var(--scroll-progress) * 5%),
      rgba(0, 0, 0, 0.88) calc(42% + var(--scroll-progress) * 4%),
      black calc(54% + var(--scroll-progress) * 4%),
      black calc(76% - var(--scroll-progress) * 4%),
      rgba(0, 0, 0, 0.65) calc(88% - var(--scroll-progress) * 3%),
      transparent calc(96% - var(--scroll-progress) * 2%)
    );
  }

  .hero-network .hero-bg,
  .network-graph {
    pointer-events: none;
  }

  .cluster-cap {
    pointer-events: none;
    opacity: 0.72;
  }

  .edges line {
    stroke-linecap: round;
    stroke-opacity: 0.62;
    transition: none;
  }

  .edges line.edge-bridge {
    stroke-dasharray: none;
    stroke-opacity: 0.52;
  }

  .network-node {
    opacity: 0.88;
  }

  .network-node circle {
    transition: none;
  }

  .network-node--hub .network-node-core {
    stroke: rgba(210, 228, 255, 0.22);
    stroke-width: 0.55;
  }

  .network-graph .edge-gradient-stop--mid {
    stop-color: color-mix(
      in srgb,
      rgba(130, 172, 255, 0.34) calc(var(--scroll-progress) * 100%),
      rgba(91, 141, 239, 0.18) calc((1 - var(--scroll-progress)) * 100%)
    );
  }

  .network-graph .node-gradient-stop:first-child {
    stop-color: color-mix(
      in srgb,
      rgba(176, 206, 255, 0.5) calc(var(--scroll-progress) * 100%),
      rgba(142, 180, 255, 0.34) calc((1 - var(--scroll-progress)) * 100%)
    );
  }

  .network-graph .nodes,
  .network-graph .cluster-caps {
    opacity: calc(0.92 - var(--scroll-progress) * 0.18);
  }

  @media (max-width: 768px) {
    .network-graph {
      min-width: 0;
    }
  }
</style>